---
import '../styles/custom.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Dither & ASCII Studio Engine',
  description = 'High-performance real-time Dither, Jitter, and ASCII art generator built with Astro, Svelte 5, and Canvas 2D.',
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <div class="app-viewport">
      <!-- Top Navigation Header -->
      <header class="app-header">
        <div class="header-left">
          <a href={`${baseUrl}/`} class="brand-logo">
            <span class="brand-bracket">[</span>
            <span class="brand-name font-pixel">ASCII // DITHER</span>
            <span class="brand-bracket">]</span>
          </a>
          <span class="header-divider">|</span>
          <div class="tool-selector">
            <span class="tool-tab active font-mono">01. DITHER MATRIX</span>
            <span class="tool-tab upcoming font-mono" title="More creative tools coming soon">+ TOOL 02</span>
          </div>
        </div>

        <div class="header-center">
          <div class="system-status font-mono">
            <span class="status-indicator"></span>
            <span class="status-label">ENGINE ONLINE</span>
          </div>
        </div>

        <div class="header-right">
          <a
            href="https://github.com/WarunaUdara/custom-ascii-art-tool-oss"
            target="_blank"
            rel="noopener noreferrer"
            class="header-btn font-mono"
            title="View Source on GitHub"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            <span>GITHUB</span>
          </a>
        </div>
      </header>

      <!-- Main Workspace -->
      <main class="app-main">
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  .app-viewport {
    display: flex;
    flex-direction: column;
    height: 100vh;
    width: 100vw;
    background: #000000;
    overflow: hidden;
  }

  .app-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 44px;
    min-height: 44px;
    padding: 0 16px;
    background: #000000;
    border-bottom: 1px solid #1f1f26;
    z-index: 100;
    user-select: none;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 4px;
    color: #ffffff;
    text-decoration: none;
    font-size: 12px;
    letter-spacing: 0.05em;
  }

  .brand-bracket {
    color: #52525b;
    font-family: var(--font-mono);
  }

  .brand-name {
    color: #ff5b35;
    font-weight: 700;
  }

  .header-divider {
    color: #27272a;
    font-size: 11px;
  }

  .tool-selector {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .tool-tab {
    font-size: 10px;
    padding: 3px 8px;
    border-radius: 3px;
    letter-spacing: 0.02em;
  }

  .tool-tab.active {
    background: #18181b;
    color: #ededed;
    border: 1px solid #27272a;
  }

  .tool-tab.upcoming {
    color: #52525b;
    border: 1px dashed #27272a;
    cursor: default;
  }

  .header-center {
    display: flex;
    align-items: center;
  }

  .system-status {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 9px;
    color: #71717a;
    letter-spacing: 0.05em;
    background: #09090b;
    border: 1px solid #1f1f26;
    padding: 2px 8px;
    border-radius: 999px;
  }

  .status-indicator {
    width: 5px;
    height: 5px;
    background: #22c55e;
    border-radius: 50%;
    box-shadow: 0 0 6px rgba(34, 197, 94, 0.8);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .header-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 8px;
    background: #09090b;
    border: 1px solid #27272a;
    border-radius: 3px;
    color: #a1a1aa;
    font-size: 10px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .header-btn:hover {
    border-color: #ff5b35;
    color: #ffffff;
    background: #121216;
  }

  .app-main {
    flex: 1;
    display: flex;
    overflow: hidden;
    position: relative;
  }

  @media (max-width: 768px) {
    .tool-selector,
    .header-center {
      display: none;
    }
  }
</style>
